{
  "sourceCommit": "58ba45a978e1ebaeae71d9e88509703a9bd67bd6",
  "phrases": [
    {
      "id": "preset_7ACA0926-DB7F-4B9E-872C-AE9690AD79E7",
      "text": "我要去洗手间",
      "english": "I need to go to the restroom",
      "group": "基本需要"
    },
    {
      "id": "preset_9DEB32B5-8606-4689-8F6A-0B251F4DB377",
      "text": "我口渴",
      "english": "I am thirsty",
      "group": "基本需要"
    },
    {
      "id": "preset_E012D902-E8BA-4BEA-92C7-7107ECF8051C",
      "text": "我饿了",
      "english": "I am hungry",
      "group": "基本需要"
    },
    {
      "id": "preset_8C4D0099-9BA8-4914-A6B5-730FFDC8C499",
      "text": "我冷",
      "english": "I am cold",
      "group": "基本需要"
    },
    {
      "id": "preset_6AD93FB9-437C-455F-A4AF-C96033BCBCAE",
      "text": "我热",
      "english": "I am hot",
      "group": "基本需要"
    },
    {
      "id": "preset_F6F03BBD-B9CD-41F5-B26A-FCC13CCBB199",
      "text": "我累了",
      "english": "I am tired",
      "group": "基本需要"
    },
    {
      "id": "preset_ADDD57C6-D11E-4B32-A2B3-05AA43D9AC8C",
      "text": "我还可以",
      "english": "I am fine",
      "group": "基本需要"
    },
    {
      "id": "preset_C6C14627-E48E-4EF3-B81D-64C191F2EC75",
      "text": "我感觉不错",
      "english": "I am good",
      "group": "基本需要"
    },
    {
      "id": "preset_C6E6B6E7-BEB6-466D-822A-F8CE2D092B9E",
      "text": "我不舒服",
      "english": "I am uncomfortable",
      "group": "基本需要"
    },
    {
      "id": "preset_5542BE2F-419E-41A5-BBF2-5B82E0A49834",
      "text": "我疼了",
      "english": "I am in pain",
      "group": "基本需要"
    },
    {
      "id": "preset_28A8F6B6-E196-4981-B762-652C288A0C29",
      "text": "我已完成",
      "english": "I am finished",
      "group": "基本需要"
    },
    {
      "id": "preset_0B491C3E-1A7F-4A94-A523-6DE329BF9E72",
      "text": "我想躺下",
      "english": "I want to lie down",
      "group": "基本需要"
    },
    {
      "id": "preset_BBE8BABC-CCBF-49BF-87D4-057016AADBC5",
      "text": "我想坐起来",
      "english": "I want to sit up",
      "group": "基本需要"
    },
    {
      "id": "preset_3EF1FBFA-E07A-47B5-BDF6-3AE7A684B834",
      "text": "您好",
      "english": "Hello",
      "group": "对话"
    },
    {
      "id": "preset_9929E83B-997D-40AA-841C-130709F5115B",
      "text": "早上好",
      "english": "Good morning",
      "group": "对话"
    },
    {
      "id": "preset_D6A67E02-3D07-4D44-8B04-2C1B9B8B167E",
      "text": "晚安",
      "english": "Good evening",
      "group": "对话"
    },
    {
      "id": "preset_0EE14D06-92D7-4A26-A15F-253528F14A69",
      "text": "很高兴认识你",
      "english": "Pleased to meet you",
      "group": "对话"
    },
    {
      "id": "preset_0EF33A3F-41E8-4E47-9B2C-69FC86B957FC",
      "text": "您今天过得怎么样？",
      "english": "How is your day?",
      "group": "对话"
    },
    {
      "id": "preset_1B634A96-563E-4275-875A-2B705A5D1178",
      "text": "您好吗？",
      "english": "How are you?",
      "group": "对话"
    },
    {
      "id": "preset_31E8760F-E728-4261-A82E-B50AB40C73FF",
      "text": "您最近怎么样了？",
      "english": "How's it going?",
      "group": "对话"
    },
    {
      "id": "preset_24B48F19-EA3A-49A1-88C1-AACB67FE7278",
      "text": "您的周末如何？",
      "english": "How was your weekend?",
      "group": "对话"
    },
    {
      "id": "preset_B2442AA0-6004-4636-9B39-2DB97ADD1DA1",
      "text": "再見",
      "english": "Goodbye",
      "group": "对话"
    },
    {
      "id": "preset_045EF309-3EB7-46B9-8AB7-31BC8482E3DC",
      "text": "对",
      "english": "Okay",
      "group": "对话"
    },
    {
      "id": "preset_573DD827-7201-49F1-8BE8-0BC18028A8CB",
      "text": "差",
      "english": "Bad",
      "group": "对话"
    },
    {
      "id": "preset_D64EE532-14D3-4434-B671-8F4368EC0A8D",
      "text": "很好",
      "english": "Good",
      "group": "对话"
    },
    {
      "id": "preset_6B463AF1-C884-45CD-9194-90806E75FD70",
      "text": "有道理",
      "english": "That makes sense",
      "group": "对话"
    },
    {
      "id": "preset_A436EAAF-BD8A-4D8D-81EA-DC6D3C849D4A",
      "text": "我喜欢",
      "english": "I like it",
      "group": "对话"
    },
    {
      "id": "preset_A02D6604-5C7C-4BB0-8C4A-E1C5E0D1A869",
      "text": "请停止",
      "english": "Please stop",
      "group": "对话"
    },
    {
      "id": "preset_30153E11-D48C-47C8-9186-47988D0A5B7A",
      "text": "我不同意",
      "english": "I do not agree",
      "group": "对话"
    },
    {
      "id": "preset_A74483A8-4069-40D7-992C-01295934E97C",
      "text": "请重复你说过的话",
      "english": "Please repeat what you said",
      "group": "对话"
    },
    {
      "id": "preset_33B3F4B7-2438-439B-A21B-46D2599C8840",
      "text": "请",
      "english": "Please",
      "group": "常用"
    },
    {
      "id": "preset_72633C5C-47A2-4D5E-9615-E1408234478F",
      "text": "谢谢",
      "english": "Thank you",
      "group": "常用"
    },
    {
      "id": "preset_8BCBACFB-D5ED-46CB-B3E2-21FB31D8D6AD",
      "text": "是",
      "english": "Yes",
      "group": "常用"
    },
    {
      "id": "preset_FABE749C-B54D-4031-B8E7-62777B34D273",
      "text": "不是",
      "english": "No",
      "group": "常用"
    },
    {
      "id": "preset_DFB79E0D-CF93-4744-B9EE-12738E1864E2",
      "text": "可能",
      "english": "Maybe",
      "group": "常用"
    },
    {
      "id": "preset_7FF4503F-F838-48BE-B529-758B3531093C",
      "text": "请稍等",
      "english": "Please wait",
      "group": "常用"
    },
    {
      "id": "preset_6CBD6D3E-42A7-435C-B661-2ABD669DC6BE",
      "text": "我不知道",
      "english": "I don't know",
      "group": "常用"
    },
    {
      "id": "preset_BEE6FF86-CE30-4096-9E37-C469F63630B7",
      "text": "我不是那个意思",
      "english": "I didn't mean to say that",
      "group": "常用"
    },
    {
      "id": "preset_63980C93-EE77-40DE-BDE7-BF8F97EC0304",
      "text": "请耐心等待",
      "english": "Please be patient",
      "group": "常用"
    },
    {
      "id": "preset_9E3230D7-1172-491A-8A00-E734B1661DC1",
      "text": "请开灯",
      "english": "Please turn the lights on",
      "group": "环境"
    },
    {
      "id": "preset_46EF7041-50F7-4B64-A0F6-879A8A3D7532",
      "text": "请关灯",
      "english": "Please turn the lights off",
      "group": "环境"
    },
    {
      "id": "preset_9A808275-0D67-49E4-8BF8-6F22A0C7E169",
      "text": "请拒绝访客",
      "english": "No visitors please",
      "group": "环境"
    },
    {
      "id": "preset_E7D11E13-BC4F-4FE5-9C8A-BE2DE31AEE7F",
      "text": "我想要访客",
      "english": "I would like visitors",
      "group": "环境"
    },
    {
      "id": "preset_30474911-619F-4FBF-B7DA-F64039F556F2",
      "text": "请保持静音",
      "english": "Please be quiet",
      "group": "环境"
    },
    {
      "id": "preset_0167AA43-587D-436F-91A9-9CEEAF1CCCF1",
      "text": "我想说几句话",
      "english": "I would like to talk",
      "group": "环境"
    },
    {
      "id": "preset_FB19C160-BC96-4580-9542-6F54AA1B2D70",
      "text": "请打开电视机",
      "english": "Please turn the TV on",
      "group": "环境"
    },
    {
      "id": "preset_9EE3A781-E84E-4728-976F-8EF993B8174C",
      "text": "请关闭电视机",
      "english": "Please turn the TV off",
      "group": "环境"
    },
    {
      "id": "preset_DC942BB6-B2BF-4ABB-8931-719BD2A504E6",
      "text": "请调高音量",
      "english": "Please turn the volume up",
      "group": "环境"
    },
    {
      "id": "preset_702D3BAD-6C56-4DC6-8290-8E0693B63152",
      "text": "请调低音量",
      "english": "Please turn the volume down",
      "group": "环境"
    },
    {
      "id": "preset_42DC7273-92F9-4149-8166-966C3C201862",
      "text": "请打开百叶窗",
      "english": "Please open the blinds",
      "group": "环境"
    },
    {
      "id": "preset_88556B8E-FE61-401D-888C-0D79568715A0",
      "text": "请关闭百叶窗",
      "english": "Please close the blinds",
      "group": "环境"
    },
    {
      "id": "preset_2BF1A363-CE24-4F26-9727-C5EAD1FEC27C",
      "text": "请打开窗口",
      "english": "Please open the window",
      "group": "环境"
    },
    {
      "id": "preset_C865BE96-40B5-406C-9BAA-0A0D3280E377",
      "text": "请关闭窗口",
      "english": "Please close the window",
      "group": "环境"
    },
    {
      "id": "preset_1244394F-2793-47EF-BCAC-DB8BBDAB78C6",
      "text": "我需要我的药物",
      "english": "I need my medication",
      "group": "个人护理"
    },
    {
      "id": "preset_64348AD1-9F63-4ADA-B391-E1742913C0E6",
      "text": "我需要洗澡",
      "english": "I need a bath",
      "group": "个人护理"
    },
    {
      "id": "preset_81B473E3-2FC9-40F0-AE59-3C658EC6CD91",
      "text": "我需要冲凉",
      "english": "I need a shower",
      "group": "个人护理"
    },
    {
      "id": "preset_73B654AA-C999-4864-BF5A-77379DAA991C",
      "text": "我需要洗脸",
      "english": "I need to wash my face",
      "group": "个人护理"
    },
    {
      "id": "preset_1BAD392A-C26C-4080-B0F2-FC544E08349C",
      "text": "我需要梳头",
      "english": "I need to brush my hair",
      "group": "个人护理"
    },
    {
      "id": "preset_4F776A4A-4154-4DFE-89AC-E603C2A578EE",
      "text": "请安好我的枕头",
      "english": "Please fix my pillow",
      "group": "个人护理"
    },
    {
      "id": "preset_8359B09D-7259-40CC-B258-02895ECC4DB7",
      "text": "我要吐痰",
      "english": "I need to spit",
      "group": "个人护理"
    },
    {
      "id": "preset_939B4829-D8B4-42F1-B8A2-0E956AAE1FEE",
      "text": "我呼吸困难",
      "english": "I am having trouble breathing",
      "group": "个人护理"
    },
    {
      "id": "preset_05754D0C-962D-48C3-8554-E4F7D5E86D93",
      "text": "我需要外套",
      "english": "I need a jacket",
      "group": "个人护理"
    }
  ]
}
